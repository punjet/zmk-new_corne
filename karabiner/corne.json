{
    "title": "Eyelash Corne (zmk-new_corne mac-aerospace)",
    "rules": [
        {
            "description": "Caps Lock and Left Option to Cmd+Ctrl+Alt (Left Option disabled in Logic Pro and Final Cut Pro)",
            "manipulators": [
                {
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_command",
                            "modifiers": [
                                "left_control",
                                "left_option"
                            ]
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^com\\.apple\\.logic10$",
                                "^com\\.apple\\.FinalCutApp$"
                            ],
                            "type": "frontmost_application_unless"
                        }
                    ],
                    "from": {
                        "key_code": "left_option",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_command",
                            "modifiers": [
                                "left_control",
                                "left_option"
                            ]
                        }
                    ],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Corne: Pause = toggle ABC <-> RussianWin (left FN tap)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "pause",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "vendor_id": 7504,
                                    "product_id": 24926
                                }
                            ]
                        },
                        {
                            "type": "input_source_if",
                            "input_sources": [
                                {
                                    "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$"
                                }
                            ]
                        }
                    ],
                    "to": [
                        {
                            "select_input_source": {
                                "input_source_id": "^com\\.apple\\.keylayout\\.ABC$"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "pause",
                        "modifiers": {
