#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUM  1
#define FUNC 2
#define AERO 3

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        // Mod-tap that becomes the modifier as soon as another key is pressed while held,
        // so Cmd+Option+I and Option+click register immediately. Tap then hold = key repeat.
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Mod-Tap (hold-preferred)";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Left FN: tap = Pause (Karabiner toggles ABC <-> RussianWin), hold = NUM layer.
        // Balanced: the layer only wins if another key is pressed AND released while held,
        // so rolling into the next letter right after switching still counts as a tap.
        lt_hp: lt_hp {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap (balanced)";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        // Right FN: hold = Left Option (Karabiner turns it into cmd+ctrl+alt for AeroSpace)
        // plus the AERO layer, so Right FN + Space can open Sol.
        aero: aero {
            compatible = "zmk,behavior-macro";
            display-name = "AeroSpace Hyper";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo AERO &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT &mo AERO>;
        };

        // In the AERO layer: release the held Left Option first and give Karabiner time
        // to drop Hyper, then tap Keypad = which Karabiner turns into Right Option + Space
        // (Karabiner output is not remapped again, so it is not Hyper even in Logic Pro,
        // where Right Option becomes Hyper) -> opens Sol.
        // Left Option is pressed again so Right FN still acts as Hyper afterwards.
        sol: sol {
            compatible = "zmk,behavior-macro";
            display-name = "Sol Launcher";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&macro_release &kp LALT>
                , <&macro_tap &kp KP_EQUAL>
                , <&macro_press &kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        // All six thumb keys at once = lock the Mac (Ctrl+Cmd+Q).
        // Ignored right after typing so normal thumb use never waits on it.
        lock_mac {
            bindings = <&kp LC(LG(Q))>;
            key-positions = <42 43 44 45 46 47>;
            timeout-ms = <80>;
            require-prior-idle-ms = <150>;
        };

        // Left Cmd + Left FN together (one thumb) = plain Option while held, for Option+click.
        // Sends Keypad 0, Karabiner turns it into Left Option without the Hyper remap.
        plain_option {
            bindings = <&kp KP_N0>;
            key-positions = <42 43>;
            layers = <BASE>;
            timeout-ms = <50>;
        };

        // While Left FN is held: F+D = Option+Left, J+K = Option+Right (word jumps).
        // Keypad 2 / 3, Karabiner adds Option (a firmware Left Option would become Hyper).
        word_left {
            bindings = <&kp KP_N2>;
            key-positions = <16 17>;
            layers = <NUM>;
            timeout-ms = <50>;
        };

        word_right {
            bindings = <&kp KP_N3>;
            key-positions = <23 24>;
            layers = <NUM>;
            timeout-ms = <50>;
        };

        // Home-row chords for punctuation. They send keys a Mac keyboard does not have,
        // and Karabiner types the character for the active layout (ABC or RussianWin).
        // asdf = period (Print Screen), jkl; = comma (Scroll Lock).
        // Not F13-F24: the default NKRO report cannot send them, and enabling the
        // extended report changes the HID descriptor, which breaks macOS over BLE.
        period_chord {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <14 15 16 17>;
            layers = <BASE>;
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
        };

        comma_chord {
            bindings = <&kp SCROLLLOCK>;
            key-positions = <23 24 25 26>;
            layers = <BASE>;
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R                 &kp T                               &kp UP                &kp Y      &kp U  &kp I      &kp O    &kp P     &kp LBKT
&td0       &kp A  &kp S  &kp D     &kp F                 &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V                 &kp B        &kp SPACE              &kp DOWN              &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BSPC
                         &kp LGUI  &lt_hp NUM PAUSE_BREAK  &kp SPACE                                               &kp ENTER  &aero  &hm RALT ESC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Right Enter thumb = Cmd here, so Cmd + number / arrow does not need the left
        // thumb on both Cmd and Left FN. Right FN stays transparent (Hyper), so
        // Left FN + Right FN + number reaches AeroSpace workspaces in any press order;
        // word jumps are the F+D / J+K chords. Left bottom row = undo / cut / copy / paste /
        // delete word (Keypad 1, Karabiner sends Option+Backspace: a firmware Left Option
        // would turn into Hyper); volume and previous track on the right bottom row.
        // Left FN + S / D = Insert / Application. Karabiner turns them into [ / ]
        // (in Obsidian also when the Russian layout is active).
        num_layer {
            display-name = "NUM+SYM";
            bindings = <
&kp LS(TAB)  &kp N1      &kp N2      &kp N3      &kp N4     &kp N5                          &trans                  &kp N6   &kp N7       &kp N8       &kp N9    &kp N0    &kp BSLH
&trans       &kp GRAVE   &kp INSERT  &kp K_APP   &kp MINUS  &kp EQUAL               &trans  &trans  &trans          &kp LEFT &kp DOWN     &kp UP       &kp RIGHT &kp HOME  &kp PG_UP
&trans       &kp LG(Z)   &kp LG(X)   &kp LG(C)   &kp LG(V)  &kp KP_N1       &trans          &trans                  &kp DEL  &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp END  &kp PG_DN
                                     &trans      &trans     &trans                                                  &kp LGUI &trans       &mo FUNC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        func_layer {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                      &trans                  &kp F6        &kp F7        &kp F8          &kp F9           &kp F10         &kp F11
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR          &trans  &trans  &trans          &out OUT_USB  &out OUT_BLE  &rgb_ug RGB_TOG &rgb_ug RGB_EFF  &kp LG(LS(N4))  &kp F12
&trans          &sys_reset    &kp C_BRI_DN  &bootloader   &kp C_BRI_UP  &kp C_PP    &trans          &trans                  &rgb_ug RGB_BRD &rgb_ug RGB_BRI &bootloader     &sys_reset       &rgb_ug RGB_COLOR_HSB(0,0,50) &kp C_NEXT
                                            &trans        &trans        &trans                                              &trans        &trans        &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // Active while Right FN is held (with Left Option). Everything falls through,
        // so AeroSpace gets Hyper+key; Right FN + Space opens Sol.
        aero_layer {
            display-name = "AERO";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &sol                                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
